{
  "name": "pagenest-pdf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:extension": "node extension/e2e-smoke.mjs",
    "test:extension-file": "node extension/e2e-file.mjs",
    "test:extension-range": "node extension/e2e-range.mjs",
    "test:performance": "node tests/performance-acceptance.mjs",
    "test:production": "node tests/production-acceptance.mjs",
    "test:history": "node tests/history-acceptance.mjs",
    "test:acceptance": "npm run check && npm run test:performance && npm run test:production",
    "check": "npm run typecheck && npm run build",
    "test:session": "node tests/session-acceptance.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
